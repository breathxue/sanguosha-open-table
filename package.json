{
  "name": "sanguosha-open-table",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "三国杀 · 无规则线上牌桌",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "prestart": "npm run build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=.deploy/app/server.cjs",
    "deploy": "./deploy.sh"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.23",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
